# Copiar como config/aws/dev.env y completar los valores.
# Las credenciales nunca se guardan aquí: usa un perfil de ~/.aws/credentials.
AWS_PROFILE=default
AWS_REGION=us-east-1
STAGE=dev
BEDROCK_MODEL_ID=
ALERT_EMAIL=
CUPO_DIARIO=5
MONTHLY_BUDGET_USD=10
# Completar con precios vigentes del modelo en USD por millón de tokens.
BEDROCK_INPUT_PRICE_PER_MILLION=
BEDROCK_OUTPUT_PRICE_PER_MILLION=
