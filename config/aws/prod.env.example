# Copiar como config/aws/prod.env y completar los valores.
# Usa un perfil AWS separado para producción cuando sea posible.
AWS_PROFILE=default
AWS_REGION=us-east-1
STAGE=prod
BEDROCK_MODEL_ID=
ALERT_EMAIL=
CUPO_DIARIO=5
MONTHLY_BUDGET_USD=10
# Completar con precios vigentes del modelo en USD por millón de tokens.
BEDROCK_INPUT_PRICE_PER_MILLION=
BEDROCK_OUTPUT_PRICE_PER_MILLION=
